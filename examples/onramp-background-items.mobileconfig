<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Marks onramp's LaunchDaemon as managed, so users don't get a "Background Items Added" notice for it
     during enrollment. Replace the PayloadUUIDs with your own (uuidgen).
     C7Z9CQRSHN is the Team ID that signs onramp's released packages. If you build and sign onramp
     yourself, use your own Team ID. For an unsigned build, use RuleType Label with
     io.github.popaprozac.onramp.daemon, which is weaker: it matches anything using that label. -->
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>onramp background item</string>
    <key>PayloadIdentifier</key>
    <string>io.github.popaprozac.onramp.backgrounditems</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>92130F7F-5769-4035-ABBE-8AB95B3D7FA2</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key>
            <string>Managed login items</string>
            <key>PayloadIdentifier</key>
            <string>io.github.popaprozac.onramp.backgrounditems.servicemanagement</string>
            <key>PayloadType</key>
            <string>com.apple.servicemanagement</string>
            <key>PayloadUUID</key>
            <string>B4D7AE69-BFE3-4A01-908D-857EFD98B795</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>Rules</key>
            <array>
                <dict>
                    <key>RuleType</key>
                    <string>TeamIdentifier</string>
                    <key>RuleValue</key>
                    <string>C7Z9CQRSHN</string>
                    <key>Comment</key>
                    <string>onramp, signed by its publisher</string>
                </dict>
            </array>
        </dict>
    </array>
</dict>
</plist>
