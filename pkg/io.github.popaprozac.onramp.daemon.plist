<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.popaprozac.onramp.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/onramp/onramp</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- A failed attempt exits non-zero, so launchd starts the daemon again. Success uninstalls it. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/onramp/onramp.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/onramp/onramp.log</string>
</dict>
</plist>
